{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    // Explicit override so VS Code resolves lib types without following the extends chain
    "lib": ["es2024"],
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"]
}
